{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "chrome-capability",
  "description": "Permissions for the trusted local browser chrome only. The remote content webview has no permissions.",
  "webviews": ["chrome"],
  "permissions": [
    "core:default",
    "core:webview:allow-set-webview-focus",
    "dialog:allow-save",
    "allow-get-tabs",
    "allow-create-tab",
    "allow-activate-tab",
    "allow-cycle-tab",
    "allow-close-tab",
    "allow-navigate",
    "allow-navigate-home",
    "allow-go-back",
    "allow-go-forward",
    "allow-reload",
    "allow-current-url",
    "allow-set-content-visible",
    "allow-set-content-offset",
    "allow-set-tab-overlay-height",
    "allow-get-history",
    "allow-get-history-page",
    "allow-export-history",
    "allow-get-current-profile",
    "allow-get-downloads",
    "allow-cancel-download",
    "allow-open-download",
    "allow-show-download-in-folder"
  ]
}
